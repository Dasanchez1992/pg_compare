{
  "name": "pg-compare-desktop",
  "productName": "Comparador de BD",
  "version": "1.0.0",
  "description": "App de escritorio para comparar la estructura de dos bases PostgreSQL y generar el script ALTER.",
  "main": "electron/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:backend": "node scripts/build-backend.js",
    "pack": "npm run build:backend && electron-builder --dir",
    "dist": "npm run build:backend && electron-builder",
    "dist:mac": "npm run build:backend && electron-builder --mac",
    "dist:win": "npm run build:backend && electron-builder --win",
    "dist:linux": "npm run build:backend && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^44.4.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.pgcompare.desktop",
    "productName": "Comparador de BD",
    "copyright": "Comparador de BD",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-backend/pgcompare-backend",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Comparador de BD"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Development",
      "executableName": "pg-compare",
      "desktop": {
        "entry": {
          "Name": "Comparador de BD",
          "Comment": "Compara la estructura de dos bases PostgreSQL",
          "Keywords": "postgresql;database;diff;sql;"
        }
      }
    }
  }
}
